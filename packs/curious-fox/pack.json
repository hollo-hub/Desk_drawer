{
  "schemaVersion": 1,
  "id": "curious-fox",
  "name": "Curious Fox",
  "author": "Desk Drawer",
  "version": "1.0.0",
  "license": "CC0-1.0",
  "buddy": {
    "sprite": "sprites/fox.png",
    "frame": { "w": 32, "h": 32 },
    "anchor": { "x": 16, "y": 31 },
    "animations": {
      "idle": { "frames": [0, 1], "fps": 4, "loop": true },
      "walk": { "frames": [2, 3, 4], "fps": 10, "loop": true },
      "sleep": { "frames": [5], "fps": 1, "loop": true },
      "perk": { "frames": [6, 7], "fps": 8, "loop": false },
      "happy": { "frames": [8, 9, 10], "fps": 10, "loop": false },
      "curious": { "frames": [11, 12], "fps": 6, "loop": false }
    }
  },
  "personality": {
    "energy": 85,
    "curiosity": 95,
    "chattiness": 60,
    "clinginess": 55,
    "sleepiness": 20
  },
  "lines": {
    "linkCopied": ["A new trail!", "Where does that go?"],
    "breakTaken": ["Good stretch!"]
  },
  "rules": [
    {
      "id": "curious-link",
      "name": "Investigates links",
      "enabled": true,
      "when": "clipboard.copied",
      "if": [
        { "var": "event.kind", "op": "==", "value": "link" },
        { "var": "mood.curiosity", "op": ">", "value": 50 }
      ],
      "then": [{ "play": "curious" }, { "say": "linkCopied" }],
      "cooldownSec": 10,
      "priority": 2,
      "weight": 1
    },
    {
      "id": "celebrate-break",
      "name": "Cheers for a break",
      "enabled": true,
      "when": "break.taken",
      "if": [],
      "then": [{ "play": "happy" }, { "say": "breakTaken" }],
      "cooldownSec": 5,
      "priority": 2,
      "weight": 1
    }
  ]
}
